# Neon Postgres connection string (Vercel → Storage → your Neon database → connection details).
# Use the pooled one (host contains "-pooler") once the API is deployed to serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated OAuth client IDs whose Google ID tokens we accept. The app requests tokens for the
# *Web application* client, so that's the one that goes here.
GOOGLE_CLIENT_IDS=""

# Lets the app sign in with just an email via POST /auth/dev. Never enable in production.
ALLOW_DEV_LOGIN=true

# 0.0.0.0 so a phone or Android emulator (10.0.2.2) can reach the API
HOST=0.0.0.0
PORT=3000
