# Where the app reaches the API. Defaults to http://10.0.2.2:3000 (the host machine from the
# Android emulator). On a physical phone, use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# The *Web application* OAuth client ID from the Streak Stats Google Cloud project
# (ends in .apps.googleusercontent.com). Not the Android client ID. Also add it to
# GOOGLE_CLIENT_IDS in apps/api/.env so the API accepts the tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
